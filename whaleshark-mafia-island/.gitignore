# ---------------------------------------------------------------------------
# DATA IS EXCLUDED BY DEFAULT — this is deliberate, do not relax it.
#
# The Sharkbook Tanzania records may not be used or redistributed without the
# written consent of the original data providers (MMF is ~30% of them), and the
# raw exports contain the names and email addresses of real contributors.
#
# Git history is permanent: a data file committed once and deleted later is
# still in the history and still clonable. Everything is blocked here and
# individual safe files are allow-listed back in.
# ---------------------------------------------------------------------------
data/*
!data/README.md

*.csv
*.tsv
*.xlsx
*.xls
*.kml
*.zip
*.parquet

# reports may contain counts, never records — but keep the allow-list explicit
reports/*
!reports/README.md
!reports/cleaning_report.txt

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
